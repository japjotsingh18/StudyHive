# StudyHive local development configuration. These values are not production-safe.
STUDYHIVE_ENVIRONMENT=development
STUDYHIVE_LOG_LEVEL=INFO
STUDYHIVE_API_HOST=0.0.0.0
STUDYHIVE_API_PORT=8000
STUDYHIVE_DATABASE_URL=postgresql+asyncpg://studyhive:studyhive@postgres:5432/studyhive
STUDYHIVE_REDIS_URL=redis://redis:6379/0
STUDYHIVE_STORAGE_PATH=/var/lib/studyhive/storage
STUDYHIVE_WEB_ORIGIN=http://localhost:3000
STUDYHIVE_SESSION_COOKIE_NAME=studyhive_session
STUDYHIVE_CSRF_COOKIE_NAME=studyhive_csrf
STUDYHIVE_SESSION_COOKIE_SECURE=false
STUDYHIVE_SESSION_IDLE_MINUTES=60
STUDYHIVE_SESSION_ABSOLUTE_HOURS=8
STUDYHIVE_SESSION_REMEMBER_DAYS=30
STUDYHIVE_RECENT_AUTHENTICATION_MINUTES=15
STUDYHIVE_PASSWORD_MIN_LENGTH=12
STUDYHIVE_PASSWORD_MAX_LENGTH=128
NEXT_PUBLIC_STUDYHIVE_API_URL=http://localhost:8000

POSTGRES_DB=studyhive
POSTGRES_USER=studyhive
POSTGRES_PASSWORD=studyhive
